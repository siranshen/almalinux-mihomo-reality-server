# Replace every marked value before importing into a Mihomo client, or let
# scripts/subscriptions.py fill them in for each person.
# The completed file contains a bearer credential and must not be committed.
mixed-port: 7890
mode: rule
log-level: info
ipv6: false

dns:
  enable: true
  ipv6: false
  enhanced-mode: fake-ip
  fake-ip-filter:
    - "*.lan"
    - "*.local"
  # Bootstrap is necessarily direct because the tunnel does not exist yet.
  proxy-server-nameserver:
    - system
  direct-nameserver:
    - system
  nameserver:
    - "https://1.1.1.1/dns-query#PROXY"

# Lines between "BEGIN per-server" and "END per-server" are repeated once per
# server by scripts/subscriptions.py. When filling the file by hand, list each
# server yourself.
proxies:
  # BEGIN per-server
  - name: "__SERVER_NAME__"
    type: vless
    server: __ENDPOINT_IPV4__
    port: 443
    uuid: __VLESS_UUID__
    network: tcp
    udp: true
    tls: true
    servername: __REALITY_SERVER_NAME__
    flow: xtls-rprx-vision
    packet-encoding: xudp
    client-fingerprint: chrome
    reality-opts:
      public-key: __REALITY_PUBLIC_KEY__
      short-id: "__REALITY_SHORT_ID__"
  # END per-server

# Pick the server by hand in the PROXY group.
proxy-groups:
  - name: PROXY
    type: select
    proxies:
      # BEGIN per-server
      - "__SERVER_NAME__"
      # END per-server

rule-providers:
  cn-domain:
    type: http
    behavior: domain
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geosite/cn.mrs
    path: ./ruleset/cn-domain.mrs
    interval: 86400
    proxy: PROXY
  cn-ip:
    type: http
    behavior: ipcidr
    format: mrs
    url: https://raw.githubusercontent.com/MetaCubeX/meta-rules-dat/meta/geo/geoip/cn.mrs
    path: ./ruleset/cn-ip.mrs
    interval: 86400
    proxy: PROXY

rules:
  # Fetch subscription updates directly, so a broken proxy can still be
  # replaced by refreshing. Delete this rule if you do not use subscriptions.
  - DOMAIN,__SUBSCRIPTION_HOST__,DIRECT

  # Keep administration and diagnostics to each VPS outside TUN.
  # BEGIN per-server
  - IP-CIDR,__ENDPOINT_IPV4__/32,DIRECT,no-resolve
  # END per-server

  # Keep this STUN hostname off the China-direct rule to avoid exposing the
  # client's ISP address. This is not a general WebRTC leak-prevention policy.
  - DOMAIN,stun.voip.blackberry.com,PROXY

  # Domain classification must precede target-IP classification.
  - DOMAIN-SUFFIX,lan,DIRECT
  - DOMAIN-SUFFIX,local,DIRECT
  - RULE-SET,cn-domain,DIRECT

  # no-resolve avoids local DNS solely to evaluate target-IP rules.
  - IP-CIDR,0.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,10.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,100.64.0.0/10,DIRECT,no-resolve
  - IP-CIDR,127.0.0.0/8,DIRECT,no-resolve
  - IP-CIDR,169.254.0.0/16,DIRECT,no-resolve
  - IP-CIDR,172.16.0.0/12,DIRECT,no-resolve
  - IP-CIDR,192.168.0.0/16,DIRECT,no-resolve
  - IP-CIDR6,::1/128,DIRECT,no-resolve
  - IP-CIDR6,fc00::/7,DIRECT,no-resolve
  - IP-CIDR6,fe80::/10,DIRECT,no-resolve
  - RULE-SET,cn-ip,DIRECT,no-resolve

  - MATCH,PROXY
