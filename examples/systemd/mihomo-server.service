[Unit]
Description=Mihomo VLESS REALITY server
Documentation=https://wiki.metacubex.one/en/config/inbound/listeners/vless/
Wants=network-online.target
After=network-online.target
ConditionFileIsExecutable=/usr/local/bin/mihomo
ConditionPathExists=/etc/mihomo-server/config.yaml

[Service]
Type=simple
User=mihomo
Group=mihomo
WorkingDirectory=/var/lib/mihomo-server
StateDirectory=mihomo-server
StateDirectoryMode=0700
ExecStartPre=/usr/local/bin/mihomo -t -d /var/lib/mihomo-server -f /etc/mihomo-server/config.yaml
ExecStart=/usr/local/bin/mihomo -d /var/lib/mihomo-server -f /etc/mihomo-server/config.yaml
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
KillSignal=SIGTERM
UMask=0077

# Personal-server limits sized for a 1 GiB VPS. MemoryHigh throttles before the
# hard limit; a sustained leak cannot consume the entire host.
MemoryHigh=384M
MemoryMax=640M
TasksMax=512
LimitNOFILE=65536

# TCP 443 is privileged; no other capability is needed for this non-TUN setup.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true

# systemd sandboxing. StateDirectory remains writable under ProtectSystem.
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectHostname=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictNamespaces=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
LockPersonality=true
SystemCallArchitectures=native
RemoveIPC=true

[Install]
WantedBy=multi-user.target
