# Private input for scripts/subscriptions.py.
#
# Copy to secrets/subscriptions.toml (ignored by Git), restrict it with
# `chmod 600`, and replace every __PLACEHOLDER__. The completed file holds
# every person's credential and subscription URL; protect it like a password.

# One block per VPS. Each server has its own REALITY keypair and short ID.
# Every person below can use every server.
[[servers]]
# Shown to people when they pick a server. Letters, digits, '-' or '_'.
name = "vps1"
# Current public IPv4 of the VPS. Change this when the VPS address changes.
address = "__VPS_PUBLIC_IPV4__"
# How `deploy` reaches the VPS. Uses your normal SSH keys and settings.
ssh = "root@__VPS_PUBLIC_IPV4__"
# Same values as reality-config in /etc/mihomo-server/config.yaml.
# Only the PUBLIC key belongs here; the private key stays on the VPS.
reality_server_name = "__REALITY_SERVER_NAME__"
reality_public_key = "__REALITY_PUBLIC_KEY__"
reality_short_id = "__REALITY_SHORT_ID__"

# [[servers]]
# name = "vps2"
# ...

[subscription]
# Hostname attached to the Cloudflare Worker, for example sub.example.com.
host = "__SUBSCRIPTION_HOST__"
# Profile name shown in Clash Verge Rev.
profile_name = "VPS Reality"
# How often Clash Verge Rev refreshes the profile automatically.
update_interval_hours = 12

[cloudflare]
# Only needed by the upload command. The API token is read from the
# CLOUDFLARE_API_TOKEN environment variable, never from this file.
account_id = "__CLOUDFLARE_ACCOUNT_ID__"
kv_namespace_id = "__KV_NAMESPACE_ID__"

# Optional: use your own templates instead of the ones in examples/.
# Paths are relative to this file.
# [templates]
# clash = "my-mihomo-client.yaml"
# shadowrocket = "my-shadowrocket-links.txt"

# One block per person. Generate a block with fresh values with:
#   python3 scripts/subscriptions.py new-person NAME
# `name` is also the username on the servers and must be unique. The UUID
# works on every server.
[[people]]
name = "personal"
uuid = "__VLESS_UUID__"
token = "__URL_TOKEN__"
